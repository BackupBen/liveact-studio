# --- RunPod ---
RUNPOD_API_KEY=rpk_xxx
RUNPOD_ENDPOINT_ID=xxxxxxxxxxxxxxxxxx

# --- S3 (beliebiger S3-kompatibler Speicher: MinIO, Hetzner, AWS, R2, ...) ---
# ACHTUNG: Der Worker (RunPod) braucht Zugriff auf denselben Bucket —
# bei MinIO auf dem Coolify-Host also eine öffentlich erreichbare URL setzen.
S3_ENDPOINT=https://s3.de.example.com
S3_BUCKET=liveact-studio
S3_ACCESS_KEY=xxx
S3_SECRET_KEY=xxx
S3_REGION=us-east-1

# --- Webapp ---
PUBLIC_BASE_URL=https://liveact.example.com     # für Worker-Callbacks (öffentlich!)
SESSION_SECRET=lange-zufaellige-zeichenkette     # wird auch als Callback-Token genutzt
ADMIN_PASSWORD=                                  # leer = Auth aus (intranet-only)

# --- Defaults ---
DEFAULT_GPU=NVIDIA H100
DEFAULT_SIZE=768*432
DEFAULT_FPS=25
MAX_AUDIO_MINUTES=75
CHUNK_SECONDS=120
EXECUTION_TIMEOUT_MS=7200000
